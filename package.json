{
  "name": "minimal-issues",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/api/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/api/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "tsx --test tests/*.test.ts",
    "test:web": "npm run build && playwright test",
    "cli": "tsx src/cli/index.ts",
    "user:add": "tsx scripts/add-user.ts",
    "db:migrate": "tsx src/api/migrate.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "commander": "^14.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
